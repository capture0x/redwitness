# RedWitness environment variables. To generate real values:  ./scripts/init-env.sh   (creates .env, mode 600)
# NEVER add the .env file to version control.

# --- Zorunlu -----------------------------------------------------------------------------------------------
# PostgreSQL password (used only inside the compose network)
POSTGRES_PASSWORD=
# Scope signing key: "id:64-digit hex". If you lose it, previously signed scopes can no longer be verified - back it up.
# Key rotation: write "k1:...,k2:..." and set REDWITNESS_SCOPE_ACTIVE_KEY=k2 (old keys remain for verification).
REDWITNESS_SCOPE_KEYS=
# Password of the first 'admin' account (at least 12 characters). Used ONLY while the users table is empty; afterwards manage it on the Users page.
REDWITNESS_ADMIN_PASSWORD=

# --- Opsiyonel ---------------------------------------------------------------------------------------------
# Session cookie signing secret. If empty it is generated randomly per process (sessions drop on restart).
REDWITNESS_SESSION_SECRET=
# Set to 1 if you publish behind TLS (the cookie becomes Secure)
REDWITNESS_COOKIE_SECURE=0
# The UI's port on the host (binds to 127.0.0.1 only)
REDWITNESS_PORT=3000
# Extra names to add to the backend's Host validation (comma separated). In Docker "backend" is already defined.
# REDWITNESS_ALLOWED_HOSTS=
# Application log level (DEBUG, INFO, WARNING, ERROR); errors go to `docker compose logs backend` with stack traces
# REDWITNESS_LOG_LEVEL=INFO
# Local development ONLY: turns authentication off (everyone is admin). NEVER in production.
# REDWITNESS_INSECURE_NO_AUTH=1

# Judge / target LLM keys: never written to the database; only their NAMES are given in the scope (api_key_env) and in Settings.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TARGET_API_KEY=
